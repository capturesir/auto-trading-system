{
  "schema_version": "strategy/1.0",
  "id": "sig_pullback",
  "version": 3,
  "mode": "paper",
  "name": "高信心估值訊號＋回檔進場",
  "author": "b_group",
  "created_at": "2026-10-01T13:10:00+08:00",
  "parent_version": 2,
  "markets": [
    "US",
    "JP",
    "HK",
    "KR",
    "TW"
  ],
  "universe": {
    "source": "a_group_signals",
    "asset_type": "equity",
    "exclude_pending_removal": true,
    "one_per_issuer_group": true
  },
  "trigger": {
    "type": "signal",
    "side": "BUY",
    "min_confidence": 60,
    "min_upside_live_pct": 20.0
  },
  "confirm": {
    "any_of": [
      {
        "indicator": "rsi_below",
        "period": 14,
        "value": 35
      },
      {
        "indicator": "close_below_bb_lower",
        "period": 20,
        "std": 2.0
      },
      {
        "indicator": "pullback_to_ma",
        "period": 20,
        "within_pct": 1.0,
        "require_ma_rising": 50
      }
    ],
    "guards": [
      {
        "indicator": "no_new_low",
        "lookback_high_low": 252,
        "within_sessions": 5
      }
    ]
  },
  "action": {
    "side": "buy",
    "size": {
      "type": "pct_equity",
      "value": 5.0,
      "confidence_scale": {
        "ref": 75,
        "cap": 1.0
      },
      "max_position_pct": 5.0
    },
    "order": {
      "type": "limit",
      "offset_bps": 10,
      "session": "RTH",
      "tif": "DAY"
    }
  },
  "exits": [
    {
      "type": "stop_loss_pct",
      "value": 8.0
    },
    {
      "type": "indicator_take_profit",
      "any_of": [
        {
          "indicator": "rsi_above",
          "period": 14,
          "value": 70
        },
        {
          "indicator": "close_above_bb_upper",
          "period": 20,
          "std": 2.0
        }
      ],
      "fraction": 0.5
    },
    {
      "type": "ma_break",
      "ma_period": 20,
      "active_after": "indicator_take_profit"
    },
    {
      "type": "fair_value_reached",
      "ratio": 0.98
    },
    {
      "type": "signal_reversal",
      "on_side": [
        "SELL"
      ],
      "upside_live_below_pct": 5.0
    },
    {
      "type": "time",
      "max_hold": "40td",
      "only_if_pnl_below_pct": 0.0
    }
  ],
  "portfolio": {
    "max_positions": 10,
    "max_market_pct": 50.0
  },
  "execution": {
    "approval": "auto"
  },
  "cooldown": "5td"
}
