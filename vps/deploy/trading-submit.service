[Unit]
Description=Paper order submission loop
After=network.target

[Service]
Type=simple
User=trader
WorkingDirectory=/srv/trading
Environment=TRADING_HOME=/srv/trading
Environment=IBKR_PAPER_ACCOUNT=DUR243736
Environment=IB_HOST=127.0.0.1
Environment=IB_PORT=4002
Environment=IB_CLIENT_ID=11
Environment=IB_READ_ONLY_API=yes
Environment=TRADING_GATEWAY_CONNECT=1
ExecStart=/srv/trading/.venv/bin/python -m auto_trading.execution submit
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
