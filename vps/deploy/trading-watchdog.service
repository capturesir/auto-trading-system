[Unit]
Description=Paper heartbeat watchdog
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/trading
Environment=TRADING_HOME=/srv/trading
Environment=IBKR_PAPER_ACCOUNT=DUR243736
ExecStart=/srv/trading/.venv/bin/python -m auto_trading.execution watchdog
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
